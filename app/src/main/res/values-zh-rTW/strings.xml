    <!-- Protection Switches -->
    <string name="pref_block_network_location_title">架空網路定位（僅純 GPS）</string>
    <string name="pref_block_network_location_summary">在 system_server 與 GMS 丟棄網路定位回報與請求，保留 GPS 衛星定位不受影響。</string>

    <string name="pref_block_gms_wifi_title">封鎖 GMS Wi-Fi 與 RTT 掃描</string>
    <string name="pref_block_gms_wifi_summary">對 GMS 回傳空 Wi-Fi 清單並攔截 RTT 測距，不影響正常 Wi-Fi 上網。</string>

    <string name="pref_block_gms_cell_title">封鎖 GMS 基地台資訊</string>
    <string name="pref_block_gms_cell_summary">對 GMS 隱藏鄰近基地台清單，不影響通話、簡訊與行動網路。</string>

    <string name="pref_block_gms_ble_title">封鎖 GMS 藍牙 BLE 背景掃描</string>
    <string name="pref_block_gms_ble_summary">攔截 GMS 發起的低功耗藍牙掃描，不影響耳機與已配對裝置。</string>

    <string name="pref_block_location_bypass_title">封鎖關閉定位下特殊存取</string>
    <string name="pref_block_location_bypass_summary">清除 GMS 忽略定位開關的標記，關閉總定位就徹底停止供位。</string>

    <!-- Diagnostics -->
    <string name="pref_verbose_logging_title">詳細除錯日誌</string>
    <string name="pref_verbose_logging_summary">以標籤 PlaceboLA 輸出攔截紀錄，方便透過 adb logcat 檢視。</string>

