    <string name="app_name">Placebo Location Accuracy</string>
    <string name="app_subtitle">回歸純粹的 GPS</string>
    <string name="xposed_description">讓 Google 定位精確度開關維持原樣但失去實質效果，封鎖網路定位、GMS Wi-Fi/BLE/基地台掃描與定位關閉繞過，僅保留純 GPS 衛星定位。</string>

