<resources>
    <string name="app_name">Placebo Location Accuracy</string>
    <string name="app_subtitle">回归纯粹的 GPS</string>
    <string name="xposed_description">保留 Google 位置精确度开关界面但使其失效，拦截网络定位、GMS Wi-Fi/BLE/基站扫描及关闭定位时的特权绕过，仅保留纯 GPS 卫星定位。</string>

