    <!-- Protection Switches -->
    <string name="pref_block_network_location_title">架空网络定位（仅纯 GPS）</string>
    <string name="pref_block_network_location_summary">在 system_server 与 GMS 中丢弃网络定位回报和请求，保留 GPS 卫星定位不受影响。</string>

    <string name="pref_block_gms_wifi_title">拦截 GMS Wi-Fi 与 RTT 扫描</string>
    <string name="pref_block_gms_wifi_summary">向 GMS 返回空 Wi-Fi 列表并丢弃 RTT 测距，不影响正常 Wi-Fi 上网。</string>

    <string name="pref_block_gms_cell_title">拦截 GMS 基站信息</string>
    <string name="pref_block_gms_cell_summary">向 GMS 隐藏附近基站列表，不影响通话、短信与移动数据。</string>

    <string name="pref_block_gms_ble_title">拦截 GMS 蓝牙 BLE 后台扫描</string>
    <string name="pref_block_gms_ble_summary">丢弃 GMS 发起的低功耗蓝牙扫描，不影响耳机与已配对设备。</string>

    <string name="pref_block_location_bypass_title">拦截关闭定位下特殊访问</string>
    <string name="pref_block_location_bypass_summary">清除 GMS 忽略定位开关的标记，关闭总定位即彻底停止供位。</string>

    <!-- Diagnostics -->
    <string name="pref_verbose_logging_title">详细调试日志</string>
    <string name="pref_verbose_logging_summary">以标签 PlaceboLA 输出拦截记录，便于通过 adb logcat 验证。</string>

