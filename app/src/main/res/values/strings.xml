    <!-- Protection Switches -->
    <string name="pref_block_network_location_title">Pure GPS Only</string>
    <string name="pref_block_network_location_summary">Drop network provider fixes across system_server and GMS while keeping GPS satellites intact.</string>

    <string name="pref_block_gms_wifi_title">Block GMS Wi-Fi &amp; RTT Scans</string>
    <string name="pref_block_gms_wifi_summary">Return empty Wi-Fi scan lists and drop RTT ranging for GMS without affecting Wi-Fi connectivity.</string>

    <string name="pref_block_gms_cell_title">Block GMS Cell Tower Info</string>
    <string name="pref_block_gms_cell_summary">Hide nearby cell towers from GMS without affecting calls, SMS, or mobile data.</string>

    <string name="pref_block_gms_ble_title">Block GMS BLE Scans</string>
    <string name="pref_block_gms_ble_summary">Drop background Bluetooth Low Energy scans from GMS while keeping paired devices working.</string>

    <string name="pref_block_location_bypass_title">Block Location-Off Bypass</string>
    <string name="pref_block_location_bypass_summary">Strip privileged ignore-settings flags from GMS so turning off Location truly stops fixes.</string>

    <!-- Diagnostics -->
    <string name="pref_verbose_logging_title">Verbose Debug Logging</string>
    <string name="pref_verbose_logging_summary">Write intercepted events under tag PlaceboLA for adb logcat verification.</string>

